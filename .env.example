# ============================================================
# Sistema de Gestion Integral de Citas - Barberia
# Copia este archivo como .env y completa los valores
# ============================================================

# Aplicacion
APP_NAME="Sistema de Gestion Integral de Citas"
APP_ENV=development
APP_DEBUG=true

# Base de datos SQLite
DB_PATH=data/barberia.db
BACKUP_DIR=data/backups

# Horario de operacion
HORARIO_INICIO=08:00
HORARIO_FIN=19:00
DIAS_OPERACION=Lunes,Martes,Miercoles,Jueves,Viernes,Sabado

# Ganancias
PORCENTAJE_EMPLEADO=60
PORCENTAJE_NEGOCIO=40

# Bot
BOT_PROVIDER=telegram
BOT_QUEUE_FILE=data/bot_queue.json

# Telegram — coloca aqui el token que te da @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true

# Recordatorios
REMINDER_MINUTES=60
REMINDER_ENABLED=true

# Seguridad
BCRYPT_ROUNDS=12

# Rendimiento
MAX_RESPONSE_TIME=2
